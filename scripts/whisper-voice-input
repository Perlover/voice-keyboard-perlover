#!/usr/bin/env python3
"""
Whisper Voice Input Script
Records audio and transcribes it using OpenAI Whisper API, an OpenAI-compatible
server or a local Whisper server
Then types the recognized text into the active window

Usage:
    whisper-voice-input                 record, transcribe and paste (config via env)
    whisper-voice-input --list-models   print models of the OpenAI-compatible server
                                        (COMPAT_BASE_URL, COMPAT_API_KEY) as JSON
"""

import os
import re
import sys
import tempfile
import subprocess
import json
import signal
import time
from pathlib import Path
from urllib.parse import urlparse

try:
    import requests
except ImportError:
    print("ERROR: python3-requests is not installed", file=sys.stderr)
    sys.exit(1)


# Exit codes
EXIT_SUCCESS = 0
EXIT_CONFIG_ERROR = 1
EXIT_RECORDING_ERROR = 2
EXIT_TRANSCRIPTION_ERROR = 3
EXIT_CANCELLED = 4
EXIT_TIMEOUT = 5
EXIT_CHAT_ERROR = 6
EXIT_PASTE_ERROR = 7
EXIT_NO_SPEECH = 8

# Retry policy for transient network errors (Timeout, ConnectionError)
NETWORK_RETRY_ATTEMPTS = 3  # total attempts including the first one
NETWORK_RETRY_BACKOFF = [1, 3]  # seconds to wait before attempt 2, 3

OPENAI_BASE_URL = "https://api.openai.com/v1"

# The applet reads --list-models output only after the process exits, so it
# must fit into the 64 KB pipe buffer: 500 IDs of up to ~100 chars do
MAX_LISTED_MODELS = 500

# Whisper fills silence and noise with captions from its training data: on a
# silent or noisy recording hub/stt answered "Продолжение следует..." 4 times
# out of 4 (2026-10-16). Phrases after the Tolmach server, plus fr/zh/ja/uk
HALLUCINATIONS = re.compile(
    r"субтитр|продолжение следует|спасибо за просмотр|подписывайтесь|дякую за перегляд|amara\.org|"
    r"subtítulos|suscríbete|gracias por ver|thanks for watching|subscribe|"
    r"sous-titr|merci d'avoir regardé|"
    r"untertitel\w* (?:im auftrag|des zdf)|vielen dank fürs zuschauen|\*\s*musik\s*\*|"
    r"titulky vytvořil jirka kováč|johnyx|"
    r"字幕由|谢谢观看|请不吝点赞|ご視聴ありがとうございました|チャンネル登録",
    re.IGNORECASE,
)
# A caption in place of silence is 2-5 words ("Субтитры сделал DimaTorzok").
# A longer text is real speech that may say "subtitles" itself, so only a short
# caption sentence at its end is cut. The character cap keeps a long Chinese or
# Japanese dictation (one "word" without spaces) from being dropped whole
HALLUCINATION_MAX_WORDS = 8
HALLUCINATION_MAX_CHARS = 80
HALLUCINATION_TAIL_WORDS = 5


def record_audio_user_controlled(max_duration=300, output_file="/tmp/voice-input.ogg"):
    """
    Record audio using ffmpeg until SIGTERM is received or max duration reached.
    Records to OGG/Opus format - streaming format that doesn't require finalization,
    so files are valid even if recording is interrupted abruptly.
    Returns tuple: (success: bool, reached_max: bool)
    """
    ffmpeg_process = None

    def signal_handler(signum, frame):
        # User stopped recording - kill ffmpeg and continue
        if ffmpeg_process:
            ffmpeg_process.terminate()
        raise InterruptedError("Recording stopped by user")

    # Set up signal handler for SIGTERM
    signal.signal(signal.SIGTERM, signal_handler)

    try:
        # Use PulseAudio default source with maximum duration
        # Record to OGG/Opus format - streaming format that doesn't require
        # finalization (no moov atom like M4A), so files are always valid
        cmd = [
            'ffmpeg',
            '-f', 'pulse',
            '-i', 'default',
            '-t', str(max_duration),
            '-c:a', 'libopus',
            '-b:a', '32k',  # 32kbps is sufficient for speech
            '-ar', '16000',
            '-ac', '1',
            '-y',  # Overwrite output file
            output_file
        ]

        print(f"Recording (max {max_duration} seconds)...", file=sys.stderr)
        ffmpeg_process = subprocess.Popen(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )

        # Wait for ffmpeg to complete or be terminated
        returncode = ffmpeg_process.wait()

        # Check if ffmpeg completed naturally (reached max duration)
        if returncode == 0:
            # Check file size to determine if we actually recorded something
            if os.path.exists(output_file) and os.path.getsize(output_file) > 0:
                print(f"Recording reached maximum duration ({max_duration}s)", file=sys.stderr)
                return (True, True)  # Success, reached max
            else:
                print("ERROR: No audio recorded", file=sys.stderr)
                return (False, False)
        else:
            print(f"ERROR: ffmpeg failed with code {returncode}", file=sys.stderr)
            return (False, False)

    except InterruptedError:
        # User stopped recording via SIGTERM - this is normal
        # Wait for ffmpeg to finish writing
        if ffmpeg_process:
            try:
                ffmpeg_process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                ffmpeg_process.kill()

        # Check if file was created and has content
        if os.path.exists(output_file) and os.path.getsize(output_file) > 0:
            print("Recording stopped by user", file=sys.stderr)
            return (True, False)  # Success, user stopped
        else:
            print("ERROR: No audio recorded", file=sys.stderr)
            return (False, False)

    except Exception as e:
        print(f"ERROR: Recording failed: {e}", file=sys.stderr)
        if ffmpeg_process:
            try:
                ffmpeg_process.kill()
            except:
                pass
        return (False, False)


def _post_with_retry(label, build_request):
    """
    Execute a POST request with automatic retries on transient network errors.

    build_request is a callable that returns the Response object (it must
    re-open any file handles inside, because the body stream cannot be reused
    between attempts).

    Returns the Response on success, or None if all attempts failed with a
    transient error. Non-transient exceptions propagate.
    """
    last_err = None
    for attempt in range(1, NETWORK_RETRY_ATTEMPTS + 1):
        try:
            start_time = time.time()
            response = build_request()
            elapsed = time.time() - start_time
            print(f"{label}: response in {elapsed:.1f}s (attempt {attempt})", file=sys.stderr)
            return response
        except requests.exceptions.Timeout as e:
            last_err = ("timeout", e)
            print(f"WARN: {label}: timeout on attempt {attempt}/{NETWORK_RETRY_ATTEMPTS}", file=sys.stderr)
        except requests.exceptions.ConnectionError as e:
            last_err = ("connection", e)
            print(f"WARN: {label}: connection error on attempt {attempt}/{NETWORK_RETRY_ATTEMPTS}: {e}", file=sys.stderr)

        # Wait before retrying, unless this was the last attempt
        if attempt < NETWORK_RETRY_ATTEMPTS:
            delay = NETWORK_RETRY_BACKOFF[attempt - 1] if attempt - 1 < len(NETWORK_RETRY_BACKOFF) else NETWORK_RETRY_BACKOFF[-1]
            print(f"WARN: {label}: retrying in {delay}s", file=sys.stderr)
            time.sleep(delay)

    if last_err:
        kind, exc = last_err
        if kind == "timeout":
            print(f"ERROR: {label}: server did not respond after {NETWORK_RETRY_ATTEMPTS} attempts", file=sys.stderr)
        else:
            print(f"ERROR: {label}: cannot connect after {NETWORK_RETRY_ATTEMPTS} attempts: {exc}", file=sys.stderr)
    return None


def normalize_base_url(url):
    """
    Normalize the base URL of an OpenAI-compatible server: strip trailing
    slashes and an endpoint path pasted by mistake; a bare host gets the
    conventional /v1 prefix.
    """
    url = url.strip().rstrip('/')
    for suffix in ('/audio/transcriptions', '/chat/completions', '/models'):
        if url.endswith(suffix):
            url = url[:-len(suffix)].rstrip('/')
            break
    if urlparse(url).path == '':
        url += '/v1'
    return url


def transcribe_openai(audio_file, api_key, language="auto", model="whisper-1"):
    """
    Transcribe audio using OpenAI Whisper API
    """
    if not api_key:
        print("ERROR: OPENAI_API_KEY is not set", file=sys.stderr)
        return None

    return transcribe_openai_compatible(audio_file, OPENAI_BASE_URL, api_key,
                                        language, model, label="OpenAI API")


def transcribe_openai_compatible(audio_file, base_url, api_key, language="auto",
                                 model="whisper-1", label="OpenAI-compatible server"):
    """
    Transcribe audio via POST {base_url}/audio/transcriptions (OpenAI API format).
    The API key is optional: self-hosted servers often run without one.
    """
    try:
        url = base_url + "/audio/transcriptions"
        headers = {}
        if api_key:
            headers["Authorization"] = f"Bearer {api_key}"

        # Check file size for debugging
        file_size = os.path.getsize(audio_file)
        print(f"Audio file size: {file_size} bytes", file=sys.stderr)
        print(f"Sending request to {label} at {url} (model: {model})...", file=sys.stderr)

        def build_request():
            # Re-open file on every attempt — the request body stream is consumed
            f = open(audio_file, 'rb')
            try:
                files = {
                    'file': (os.path.basename(audio_file), f, 'audio/ogg'),
                    'model': (None, model)
                }
                if language != "auto":
                    files['language'] = (None, language)
                # Timeout: 10 sec for connection, 30 sec for server response
                return requests.post(url, headers=headers, files=files, timeout=(10, 30))
            finally:
                f.close()

        response = _post_with_retry(label, build_request)
        if response is None:
            return None

        if response.status_code == 200:
            try:
                result = response.json()
            except ValueError:
                # Some compatible servers answer with plain text
                if response.headers.get('Content-Type', '').startswith('text/plain'):
                    return response.text.strip()
                print(f"ERROR: {label}: non-JSON response: {response.text[:300]}", file=sys.stderr)
                return None
            # No "text" at all is a broken answer; an empty one means no speech
            if not isinstance(result, dict) or not isinstance(result.get('text'), str):
                print(f"ERROR: {label}: no text in response: {response.text[:300]}", file=sys.stderr)
                return None
            return result['text'].strip()
        elif response.status_code == 429:
            print(f"ERROR: {label}: rate limit exceeded. Please wait and try again.", file=sys.stderr)
            return None
        elif response.status_code == 401:
            print(f"ERROR: {label}: API key is invalid or expired.", file=sys.stderr)
            return None
        elif response.status_code == 400:
            print(f"ERROR: {label}: bad request: {response.text}", file=sys.stderr)
            return None
        else:
            print(f"ERROR: {label}: error {response.status_code} {response.text}", file=sys.stderr)
            return None

    except Exception as e:
        print(f"ERROR: {label}: transcription failed: {e}", file=sys.stderr)
        return None


def _short_connection_error(exc):
    """
    Reduce a urllib3 connection error chain to its human-readable cause
    ("Connection refused", "Name or service not known", ...).
    """
    text = str(exc)
    if 'CERTIFICATE_VERIFY_FAILED' in text:
        return "SSL certificate verification failed"
    match = re.search(r"\[Errno -?\d+\] ([^'\")]+)", text)
    if match:
        return match.group(1).strip()
    return text[:300]


def list_models(base_url, api_key):
    """
    Fetch model IDs via GET {base_url}/models (OpenAI API format).
    Returns (models, None) on success or (None, error_message) on failure.
    Single attempt without retries: the user is waiting for the answer.
    """
    url = base_url + "/models"
    headers = {}
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"

    try:
        response = requests.get(url, headers=headers, timeout=(5, 15))
    except requests.exceptions.Timeout:
        return None, f"Server did not respond: {url}"
    except requests.exceptions.ConnectionError as e:
        return None, f"Cannot connect to {url}: {_short_connection_error(e)}"
    except requests.exceptions.RequestException as e:
        return None, f"Request to {url} failed: {str(e)[:300]}"

    if response.status_code in (401, 403):
        return None, f"HTTP {response.status_code} from {url}: access denied, check the API key"
    if response.status_code == 404:
        return None, f"HTTP 404: {url} not found, check the base URL (it usually ends with /v1)"
    if response.status_code != 200:
        return None, f"HTTP {response.status_code} from {url}: {response.text[:300]}"

    try:
        payload = response.json()
    except ValueError:
        return None, f"{url} returned a non-JSON response, is it an OpenAI-compatible API?"

    # OpenAI format is {"data": [{"id": ...}]}; tolerate {"models": [...]} and bare lists
    if isinstance(payload, dict):
        items = payload.get('data')
        if items is None:
            items = payload.get('models')
    else:
        items = payload

    models = []
    for item in items if isinstance(items, list) else []:
        name = (item.get('id') or item.get('name')) if isinstance(item, dict) else item
        if isinstance(name, str) and name and name not in models:
            models.append(name)
    models.sort(key=str.lower)
    return models, None


def list_models_command():
    """
    --list-models: print the compatible server's models as JSON to stdout,
    {"models": [...]} or {"error": "..."}. Returns the process exit code.
    """
    base_url = os.environ.get('COMPAT_BASE_URL', '').strip()
    if not base_url:
        print(json.dumps({"error": "Server base URL is not set"}))
        return EXIT_CONFIG_ERROR

    base_url = normalize_base_url(base_url)
    models, error = list_models(base_url, os.environ.get('COMPAT_API_KEY', '').strip())
    if error:
        print(json.dumps({"error": error, "base_url": base_url}))
        return EXIT_CONFIG_ERROR

    print(json.dumps({"models": models[:MAX_LISTED_MODELS], "total": len(models),
                      "base_url": base_url}))
    return EXIT_SUCCESS


def transcribe_local(audio_file, server_url, language="auto"):
    """
    Transcribe audio using local Whisper server (e.g., faster-whisper-server)
    """
    try:
        file_size = os.path.getsize(audio_file)
        print(f"Audio file size: {file_size} bytes", file=sys.stderr)
        print(f"Sending to local Whisper server at {server_url}...", file=sys.stderr)

        def build_request():
            f = open(audio_file, 'rb')
            try:
                files = {
                    'audio_file': (os.path.basename(audio_file), f, 'audio/ogg')
                }
                data = {}
                if language != "auto":
                    data['language'] = language
                return requests.post(server_url, files=files, data=data, timeout=(10, 30))
            finally:
                f.close()

        response = _post_with_retry("Local Whisper", build_request)
        if response is None:
            return None

        if response.status_code == 200:
            result = response.json()
            # Handle different response formats from various Whisper servers
            if 'text' in result:
                return result['text'].strip()
            elif 'transcription' in result:
                return result['transcription'].strip()
            elif 'results' in result and len(result['results']) > 0:
                return result['results'][0].get('transcript', '').strip()
            else:
                print(f"ERROR: Unexpected response format: {result}", file=sys.stderr)
                return None
        else:
            print(f"ERROR: Local server error: {response.status_code} {response.text}", file=sys.stderr)
            return None

    except Exception as e:
        print(f"ERROR: Local transcription failed: {e}", file=sys.stderr)
        return None


def drop_hallucinations(text):
    """
    Remove what Whisper writes for silence or noise instead of speech.
    Returns '' for a text with no letters or digits ("...", "♪") and for a
    short caption ("Продолжение следует...", "Thanks for watching!"); a longer
    text comes back without a short caption sentence at its end, if it has one
    """
    text = text.strip()
    if not re.search(r"[^\W_]", text):
        return ""
    if not HALLUCINATIONS.search(text):
        return text
    if len(text.split()) <= HALLUCINATION_MAX_WORDS and len(text) <= HALLUCINATION_MAX_CHARS:
        return ""
    tail = re.search(r"[.!?…]\s+([^.!?…]+[.!?…]*)$", text)
    if (tail and HALLUCINATIONS.search(tail.group(1))
            and len(tail.group(1).split()) <= HALLUCINATION_TAIL_WORDS):
        return text[:tail.start() + 1]
    return text


def _is_reasoning_model(model):
    """Check if model is a reasoning model that uses reasoning_effort instead of temperature."""
    # gpt-5.2, gpt-5.1, gpt-5-pro etc. are reasoning models (dot notation or -pro suffix)
    # gpt-5-mini, gpt-5-nano are standard chat models that support temperature
    return model.startswith('gpt-5.') or model.endswith('-pro')


def chat_completion(text, system_prompt, api_key, model="gpt-4o-mini",
                    base_url=OPENAI_BASE_URL, label="OpenAI Chat", disable_thinking=False):
    """
    Process text through a Chat Completions API with a custom system prompt:
    POST {base_url}/chat/completions, by default https://api.openai.com/v1/chat/completions.
    The API key is mandatory for OpenAI only; compatible servers may run without one.
    disable_thinking turns off reasoning of self-hosted models via the chat
    template (vLLM / SGLang extension, unknown to OpenAI itself).
    Returns processed text or None on error.
    """
    if not api_key and base_url == OPENAI_BASE_URL:
        print("ERROR: OPENAI_API_KEY is not set for chat completion", file=sys.stderr)
        return None
    if not model:
        print("ERROR: chat model is not set for chat completion", file=sys.stderr)
        return None

    try:
        url = base_url + "/chat/completions"
        headers = {"Content-Type": "application/json"}
        if api_key:
            headers["Authorization"] = f"Bearer {api_key}"

        is_reasoning = _is_reasoning_model(model)

        payload = {
            "model": model,
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": text}
            ]
        }

        if not is_reasoning:
            payload["temperature"] = 0.3
        if disable_thinking:
            payload["chat_template_kwargs"] = {"enable_thinking": False}

        print(f"Chat API request: {url}, model={model}, thinking={'off' if disable_thinking else 'default'}, prompt_len={len(system_prompt)}, text_len={len(text)}", file=sys.stderr)

        def build_request():
            return requests.post(url, headers=headers, json=payload, timeout=(10, 60))

        response = _post_with_retry(label, build_request)
        if response is None:
            return None

        if response.status_code == 200:
            result = response.json()
            content = result['choices'][0]['message']['content'] or ''
            # Self-hosted reasoning models may put their thinking into the
            # answer — it must not be pasted. Qwen3 emits <think>…</think>;
            # DeepSeek-R1, QwQ and Qwen3-Thinking open the tag in the prompt
            # template, so only the closing </think> reaches the answer.
            content = re.sub(r'^.*?</think>', '', content, flags=re.DOTALL).strip()
            if not content:
                print(f"ERROR: {label}: empty answer from model {model}", file=sys.stderr)
                return None
            print(f"Chat API: {len(content)} chars received", file=sys.stderr)
            return content
        else:
            print(f"ERROR: Chat API error: {response.status_code} {response.text}", file=sys.stderr)
            return None

    except Exception as e:
        print(f"ERROR: Chat completion failed: {e}", file=sys.stderr)
        return None


def get_active_window():
    """
    Get the active window ID using xdotool
    Returns window ID as string, or None on error
    """
    try:
        result = subprocess.run(
            ['xdotool', 'getactivewindow'],
            capture_output=True,
            text=True,
            timeout=2
        )

        if result.returncode == 0:
            return result.stdout.strip()
        else:
            print(f"ERROR: Failed to get active window: {result.stderr}", file=sys.stderr)
            return None

    except Exception as e:
        print(f"ERROR: Window tracking failed: {e}", file=sys.stderr)
        return None


def copy_to_clipboard(text):
    """
    Copy text to clipboard using xclip
    Returns True on success, False on failure
    """
    try:
        result = subprocess.run(
            ['xclip', '-selection', 'clipboard'],
            input=text.encode(),
            capture_output=True,
            timeout=5
        )

        if result.returncode == 0:
            return True
        else:
            print(f"ERROR: Failed to copy to clipboard: {result.stderr}", file=sys.stderr)
            return False

    except FileNotFoundError:
        print("ERROR: xclip is not installed", file=sys.stderr)
        return False
    except Exception as e:
        print(f"ERROR: Clipboard copy failed: {e}", file=sys.stderr)
        return False


def paste_text(text, window_id=None):
    """
    Paste text using CLIPBOARD + PRIMARY + Shift+Insert.
    Fast method that works in most apps including terminals.

    We copy to both selections because:
    - CLIPBOARD: used by most GUI apps with Shift+Insert
    - PRIMARY: used by terminals with Shift+Insert (they treat it like middle-click)

    Args:
        text: Text to paste
        window_id: Optional window ID to focus before pasting

    Returns:
        True on success, False on failure
    """
    if not text:
        return False

    try:
        # Step 1a: Copy text to CLIPBOARD selection using xclip
        result = subprocess.run(
            ['xclip', '-selection', 'clipboard', '-i'],
            input=text.encode(),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5
        )

        if result.returncode != 0:
            print("ERROR: Failed to copy to CLIPBOARD selection", file=sys.stderr)
            return False

        # Step 1b: Also copy to PRIMARY selection for terminals
        # Terminals often treat Shift+Insert as paste from PRIMARY, not CLIPBOARD
        subprocess.run(
            ['xclip', '-selection', 'primary', '-i'],
            input=text.encode(),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5
        )

        # Step 2: Activate target window if provided
        if window_id:
            result = subprocess.run(
                ['xdotool', 'windowactivate', '--sync', window_id],
                capture_output=True,
                text=True,
                timeout=5
            )

            if result.returncode != 0:
                print(f"WARNING: Failed to activate window {window_id}: {result.stderr}", file=sys.stderr)

            # Small delay to ensure window is ready
            time.sleep(0.05)

        # Step 3: Send Shift+Insert to paste from clipboard
        # This is universal and works in terminals, Telegram, and most GUI apps
        result = subprocess.run(
            ['xdotool', 'key', '--clearmodifiers', 'shift+Insert'],
            capture_output=True,
            text=True,
            timeout=5
        )

        if result.returncode != 0:
            print(f"ERROR: Failed to send Shift+Insert: {result.stderr}", file=sys.stderr)
            return False

        return True

    except FileNotFoundError:
        print("ERROR: xclip or xdotool is not installed", file=sys.stderr)
        return False
    except Exception as e:
        print(f"ERROR: Clipboard paste failed: {e}", file=sys.stderr)
        return False


def _print_sentinel(key, value):
    """Print a machine-readable marker line to stdout for the applet to parse."""
    print(f"{key}={value}", file=sys.stdout)


def main():
    if len(sys.argv) > 1 and sys.argv[1] == '--list-models':
        sys.exit(list_models_command())

    # Get configuration from environment variables
    whisper_mode = os.environ.get('WHISPER_MODE', 'openai').lower()
    language = os.environ.get('WHISPER_LANGUAGE', 'auto')
    max_duration = int(os.environ.get('RECORDING_DURATION', '300'))
    openai_model = os.environ.get('OPENAI_MODEL', 'whisper-1')

    # Retry modes: skip recording and/or transcription, reuse saved artifacts
    retry_transcribe_from = os.environ.get('RETRY_TRANSCRIBE_FROM', '').strip()
    retry_chat_from = os.environ.get('RETRY_CHAT_FROM', '').strip()

    # Validate configuration
    if whisper_mode == 'openai':
        api_key = os.environ.get('OPENAI_API_KEY', '')
        if not api_key:
            print("ERROR: OPENAI_API_KEY is not set", file=sys.stderr)
            sys.exit(EXIT_CONFIG_ERROR)
    elif whisper_mode == 'openai-compatible':
        if not os.environ.get('COMPAT_BASE_URL', '').strip():
            print("ERROR: COMPAT_BASE_URL is not set", file=sys.stderr)
            sys.exit(EXIT_CONFIG_ERROR)
        if not os.environ.get('COMPAT_MODEL', '').strip():
            print("ERROR: COMPAT_MODEL is not set", file=sys.stderr)
            sys.exit(EXIT_CONFIG_ERROR)
    elif whisper_mode == 'local':
        server_url = os.environ.get('WHISPER_LOCAL_URL', '')
        if not server_url:
            print("ERROR: WHISPER_LOCAL_URL is not set", file=sys.stderr)
            sys.exit(EXIT_CONFIG_ERROR)
    else:
        print(f"ERROR: Unknown WHISPER_MODE: {whisper_mode}", file=sys.stderr)
        sys.exit(EXIT_CONFIG_ERROR)

    # Capture initial active window ID for paste targeting
    initial_window_id = get_active_window()
    if not initial_window_id:
        print("WARNING: Could not get initial window ID, window tracking disabled", file=sys.stderr)

    # Decide audio file path:
    # - Normal mode: new temp file for the fresh recording
    # - Retry transcription: reuse the existing failed-run audio
    # - Retry chat:         no recording needed at all
    if retry_chat_from:
        temp_audio = None
    elif retry_transcribe_from:
        if not os.path.exists(retry_transcribe_from):
            print(f"ERROR: RETRY_TRANSCRIBE_FROM path does not exist: {retry_transcribe_from}", file=sys.stderr)
            sys.exit(EXIT_RECORDING_ERROR)
        temp_audio = retry_transcribe_from
        print(f"Retry mode: reusing audio from {temp_audio}", file=sys.stderr)
    else:
        temp_audio = tempfile.mktemp(suffix='.ogg', prefix='whisper-voice-')

    # Text state for chat-retry handoff — text file path is allocated lazily
    temp_text_path = None

    # Track which artifacts should be preserved for retry (set on transcription/
    # chat errors, checked in `finally`). Anything not preserved gets cleaned up.
    preserve_audio = False
    preserve_text = False

    try:
        # Step 1: Record audio — unless we're in any retry mode
        if not retry_chat_from and not retry_transcribe_from:
            success, reached_max = record_audio_user_controlled(max_duration, temp_audio)
            if not success:
                sys.exit(EXIT_RECORDING_ERROR)
            if reached_max:
                print("Maximum recording duration reached", file=sys.stderr)
        else:
            # Retry modes: no recording happened, so `reached_max` cannot apply
            reached_max = False

        # Step 2: Transcribe — unless we're retrying the chat step only
        if retry_chat_from:
            if not os.path.exists(retry_chat_from):
                print(f"ERROR: RETRY_CHAT_FROM path does not exist: {retry_chat_from}", file=sys.stderr)
                sys.exit(EXIT_CHAT_ERROR)
            try:
                with open(retry_chat_from, 'r', encoding='utf-8') as tf:
                    text = tf.read()
            except Exception as e:
                print(f"ERROR: Cannot read RETRY_CHAT_FROM file: {e}", file=sys.stderr)
                sys.exit(EXIT_CHAT_ERROR)
            # Reuse the same text file path so subsequent chat retries keep working
            temp_text_path = retry_chat_from
            print(f"Retry mode: reusing recognized text from {temp_text_path}", file=sys.stderr)
        else:
            text = None
            if whisper_mode == 'openai':
                api_key = os.environ.get('OPENAI_API_KEY', '')
                text = transcribe_openai(temp_audio, api_key, language, openai_model)
            elif whisper_mode == 'openai-compatible':
                text = transcribe_openai_compatible(
                    temp_audio,
                    normalize_base_url(os.environ.get('COMPAT_BASE_URL', '')),
                    os.environ.get('COMPAT_API_KEY', '').strip(),
                    language,
                    os.environ.get('COMPAT_MODEL', '').strip()
                )
            elif whisper_mode == 'local':
                server_url = os.environ.get('WHISPER_LOCAL_URL', 'http://localhost:9000/asr')
                text = transcribe_local(temp_audio, server_url, language)

            if text is None:
                # Transcription failed — preserve audio so applet can offer retry
                preserve_audio = True
                _print_sentinel('AUDIO_FILE', temp_audio)
                print("ERROR: Transcription failed", file=sys.stderr)
                sys.exit(EXIT_TRANSCRIPTION_ERROR)

            print(f"Recognized: {text}", file=sys.stderr)
            heard = text
            text = drop_hallucinations(text)
            if text != heard:
                print(f"Dropped as Whisper hallucination: {len(heard) - len(text)} of {len(heard)} chars",
                      file=sys.stderr)
            if not text:
                # Silence or noise. Not a failure: a retry of the same audio
                # gets the same answer, so the recording is not kept
                print("No speech recognized", file=sys.stderr)
                sys.exit(EXIT_NO_SPEECH)

        # Step 2.5: If custom prompt mode, process through Chat API
        custom_prompt = os.environ.get('CUSTOM_PROMPT', '')
        chat_model = os.environ.get('CHAT_MODEL', 'gpt-4o-mini')

        if custom_prompt:
            print(f"Custom prompt mode: chat_model={chat_model}, prompt_len={len(custom_prompt)}", file=sys.stderr)
            if whisper_mode == 'openai-compatible':
                processed = chat_completion(
                    text, custom_prompt,
                    os.environ.get('COMPAT_API_KEY', '').strip(),
                    chat_model.strip(),
                    base_url=normalize_base_url(os.environ.get('COMPAT_BASE_URL', '')),
                    label="OpenAI-compatible chat",
                    # Reasoning is off unless allowed: a voice keyboard can't wait a minute
                    disable_thinking=os.environ.get('COMPAT_ENABLE_THINKING', '') != '1'
                )
            else:
                api_key = os.environ.get('OPENAI_API_KEY', '')
                processed = chat_completion(text, custom_prompt, api_key, chat_model)
            if not processed:
                # Chat API failed — preserve transcribed text so applet can retry
                # just the chat step without re-running Whisper.
                if not temp_text_path:
                    temp_text_path = tempfile.mktemp(suffix='.txt', prefix='whisper-voice-text-')
                    try:
                        with open(temp_text_path, 'w', encoding='utf-8') as tf:
                            tf.write(text)
                    except Exception as e:
                        print(f"WARNING: Cannot save intermediate text: {e}", file=sys.stderr)
                        temp_text_path = None
                if temp_text_path:
                    preserve_text = True
                    _print_sentinel('TEXT_FILE', temp_text_path)
                sys.exit(EXIT_CHAT_ERROR)
            text = processed
            print(f"Processed: {text}", file=sys.stderr)

        # Step 3: Paste text to original window
        if paste_text(text, initial_window_id):
            # Output recognized text to stdout (applet reads it if needed)
            print(text, file=sys.stdout)
            if reached_max:
                sys.exit(EXIT_TIMEOUT)
            else:
                sys.exit(EXIT_SUCCESS)
        else:
            # Text is already in clipboard (paste_text copies before pressing keys),
            # so the user can paste manually. Dedicated exit code tells the applet
            # to show a lightweight notification instead of a retry dialog.
            print("ERROR: paste_text() failed - text was not inserted (still in clipboard)", file=sys.stderr)
            sys.exit(EXIT_PASTE_ERROR)

    finally:
        # Cleanup: keep artifacts only when applet will offer retry for them
        if temp_audio and not preserve_audio and os.path.exists(temp_audio):
            try:
                os.remove(temp_audio)
            except Exception:
                pass
        if temp_text_path and not preserve_text and os.path.exists(temp_text_path):
            try:
                os.remove(temp_text_path)
            except Exception:
                pass


if __name__ == '__main__':
    main()
