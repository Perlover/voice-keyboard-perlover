#. applet.js - tooltip
msgid "Voice Keyboard - Left-click to start/stop recording, Right-click for settings"
msgstr "Saisie vocale - Clic gauche pour démarrer/arrêter l'enregistrement, clic droit pour les paramètres"

#. applet.js - menu
msgid "Settings"
msgstr "Paramètres"

#. applet.js - error dialog
msgid "Voice Input Error"
msgstr "Erreur de saisie vocale"

#. applet.js - error dialog
msgid "An unknown error occurred"
msgstr "Une erreur inconnue s'est produite"

#. applet.js - error dialog
msgid "Close"
msgstr "Fermer"

#. applet.js - notification
msgid "Settings are not configured"
msgstr "Les paramètres ne sont pas configurés"

#. applet.js - notification
msgid "Maximum recording time reached"
msgstr "Durée maximale d'enregistrement atteinte"

#. applet.js - error
msgid "Transcription failed"
msgstr "Échec de la transcription"

#. applet.js - error
msgid "Recording failed"
msgstr "Échec de l'enregistrement"

#. applet.js - notification
msgid "Configuration error - please check settings"
msgstr "Erreur de configuration — veuillez vérifier les paramètres"

#. applet.js - error
msgid "Process exited with code %d"
msgstr "Le processus s'est terminé avec le code %d"

#. applet.js - notification
msgid "Voice input failed"
msgstr "Échec de la saisie vocale"

#. applet.js - error
msgid "Failed to start voice input: "
msgstr "Impossible de démarrer la saisie vocale : "

#. applet.js - notification
msgid "Server did not respond in time"
msgstr "Le serveur n'a pas répondu à temps"

#. applet.js - notification (custom prompts)
msgid "AI chat processing failed"
msgstr "Échec du traitement par le chat AI"

#. applet.js - retry dialog title
msgid "Speech was not recognized"
msgstr "La parole n'a pas été reconnue"

#. applet.js - retry dialog body (transcription retry)
msgid "You can re-send the recorded audio without dictating again."
msgstr "Vous pouvez renvoyer l'audio enregistré sans avoir à redicter."

#. applet.js - retry dialog body (chat retry)
msgid "You can re-send the recognized text to the AI without dictating again."
msgstr "Vous pouvez renvoyer le texte reconnu à l'IA sans avoir à redicter."

#. applet.js - retry dialog button
msgid "Retry"
msgstr "Réessayer"

#. applet.js - paste-failed notification
msgid "Text is in the clipboard — paste it manually (Ctrl+V or Shift+Insert)"
msgstr "Le texte est dans le presse-papiers — collez-le manuellement (Ctrl+V ou Maj+Inser)"

#. settings-schema.json
msgid "Whisper mode"
msgstr "Mode Whisper"

#. settings-schema.json
msgid "OpenAI API"
msgstr "OpenAI API"

#. settings-schema.json
msgid "Local Server"
msgstr "Serveur local"

#. settings-schema.json
msgid "Choose OpenAI API, any server with an OpenAI-compatible API (e.g., your own inference hub) or a local Whisper server"
msgstr "Choisissez l'API OpenAI, n'importe quel serveur avec une API compatible OpenAI (ex. votre propre inference hub) ou un serveur Whisper local"

#. settings-schema.json
msgid "OpenAI API Key"
msgstr "Clé API OpenAI"

#. settings-schema.json
msgid "Your OpenAI API key for Whisper (required if using OpenAI mode)"
msgstr "Votre clé API OpenAI pour Whisper (requise en mode OpenAI)"

#. settings-schema.json
msgid "OpenAI Model"
msgstr "Modèle OpenAI"

#. settings-schema.json
msgid "Whisper-1 (standard, $0.006/min)"
msgstr "Whisper-1 (standard, 0,006 $/min)"

#. settings-schema.json
msgid "GPT-4o Transcribe (best quality, $0.006/min)"
msgstr "GPT-4o Transcribe (meilleure qualité, 0,006 $/min)"

#. settings-schema.json
msgid "Whisper-1: Standard speech-to-text. GPT-4o Transcribe: Latest model with best accuracy for all languages"
msgstr "Whisper-1 : Reconnaissance vocale standard. GPT-4o Transcribe : Dernier modèle avec la meilleure précision pour toutes les langues"

#. settings-schema.json
msgid "Local Whisper Server URL"
msgstr "URL du serveur Whisper local"

#. settings-schema.json
msgid "URL of your local Whisper server (e.g., faster-whisper-server)"
msgstr "URL de votre serveur Whisper local (ex. faster-whisper-server)"

#. settings-schema.json
msgid "OpenAI-compatible Server"
msgstr "Serveur compatible OpenAI"

#. settings-schema.json
msgid "Server Base URL"
msgstr "URL de base du serveur"

#. settings-schema.json
msgid "Base URL of the OpenAI-compatible API, usually ending with /v1 (e.g., https://hub.example.com/v1)"
msgstr "URL de base de l'API compatible OpenAI, se termine généralement par /v1 (ex. https://hub.example.com/v1)"

#. settings-schema.json
msgid "Server API Key"
msgstr "Clé API du serveur"

#. settings-schema.json
msgid "API key for the server. Leave empty if the server does not require authentication"
msgstr "Clé API du serveur. Laissez vide si le serveur ne demande pas d'authentification"

#. settings-schema.json
msgid "Transcription Model"
msgstr "Modèle de transcription"

#. settings-schema.json
msgid "Model name exactly as the server knows it. Use 'Check Connection' to pick it from the server's list"
msgstr "Nom du modèle exactement tel que le serveur le connaît. Utilisez « Vérifier la connexion » pour le choisir dans la liste du serveur"

#. settings-schema.json
msgid "Check Connection and Choose Transcription Model..."
msgstr "Vérifier la connexion et choisir le modèle de transcription..."

#. settings-schema.json
msgid "Connect to the server, show the list of available models and pick one with a click"
msgstr "Se connecter au serveur, afficher la liste des modèles disponibles et en choisir un d'un clic"

#. settings-schema.json
msgid "Chat Model (for prompts)"
msgstr "Modèle de chat (pour les prompts)"

#. settings-schema.json
msgid "Chat model on the server for processing recognized text with custom prompts"
msgstr "Modèle de chat du serveur pour traiter le texte reconnu avec les prompts personnalisés"

#. settings-schema.json
msgid "Choose Chat Model for Prompts..."
msgstr "Choisir le modèle de chat pour les prompts..."

#. settings-schema.json
msgid "Connect to the server, show the list of available models and pick the chat model for custom prompts with a click"
msgstr "Se connecter au serveur, afficher la liste des modèles disponibles et choisir d'un clic le modèle de chat pour les prompts"

#. settings-schema.json
msgid "Allow reasoning (thinking) of the chat model"
msgstr "Autoriser le raisonnement (thinking) du modèle de chat"

#. settings-schema.json
msgid "Off (recommended): reasoning models (Qwen3 and similar) answer many times faster, the request carries chat_template_kwargs: {\"enable_thinking\": false}, supported by vLLM and SGLang. On: the model decides itself and the field is not sent; also turn it on if the server rejects prompt requests"
msgstr "Désactivé (recommandé) : les modèles de raisonnement (Qwen3 et similaires) répondent beaucoup plus vite, la requête contient chat_template_kwargs: {\"enable_thinking\": false}, pris en charge par vLLM et SGLang. Activé : le modèle décide lui-même et le champ n'est pas envoyé ; activez-le aussi si le serveur rejette les requêtes de prompts"

#. settings-schema.json
msgid "Recognition language"
msgstr "Langue de reconnaissance"

#. settings-schema.json
msgid "Auto-detect"
msgstr "Détection automatique"

#. settings-schema.json
msgid "Russian"
msgstr "Russe"

#. settings-schema.json
msgid "English"
msgstr "Anglais"

#. settings-schema.json
msgid "Spanish"
msgstr "Espagnol"

#. settings-schema.json
msgid "German"
msgstr "Allemand"

#. settings-schema.json
msgid "French"
msgstr "Français"

#. settings-schema.json
msgid "Chinese"
msgstr "Chinois"

#. settings-schema.json
msgid "Japanese"
msgstr "Japonais"

#. settings-schema.json
msgid "Language for speech recognition"
msgstr "Langue pour la reconnaissance vocale"

#. settings-schema.json
msgid "Maximum Recording Duration"
msgstr "Durée maximale d'enregistrement"

#. settings-schema.json
msgid "Safety limit for maximum recording duration. Recording will automatically stop and transcribe when this limit is reached. Default: 5 minutes (300 seconds)."
msgstr "Limite de sécurité pour la durée maximale d'enregistrement. L'enregistrement s'arrêtera automatiquement et sera transcrit lorsque cette limite sera atteinte. Par défaut : 5 minutes (300 secondes)."

#. settings-schema.json
msgid "Path to whisper-voice-input script"
msgstr "Chemin vers le script whisper-voice-input"

#. settings-schema.json
msgid "Full path to the voice input script"
msgstr "Chemin complet vers le script de saisie vocale"

#. settings-schema.json
msgid "Chat AI Model"
msgstr "Modèle Chat AI"

#. settings-schema.json
msgid "GPT-4o Mini (fast, economical)"
msgstr "GPT-4o Mini (rapide, économique)"

#. settings-schema.json
msgid "GPT-4o (best quality)"
msgstr "GPT-4o (meilleure qualité)"

#. settings-schema.json
msgid "GPT-5 (latest)"
msgstr "GPT-5 (dernier)"

#. settings-schema.json
msgid "Model for processing text with custom prompts"
msgstr "Modèle pour le traitement de texte avec des prompts personnalisés"

#. settings-schema.json - custom-prompts-help label
msgid "Instructions: Click '+' to add. Use AI to process text. Example: Name='Fix Grammar', Prompt='Correct all typos in the following text:'"
msgstr "Instructions : Cliquez sur '+' pour ajouter. L'AI traitera le texte. Exemple : Nom='Corriger la grammaire', Prompt='Corrigez toutes les fautes dans le texte suivant :'"

#. settings-schema.json
msgid "Custom Prompts: click '+' to add. Use AI to process recognized text."
msgstr "Prompts : cliquez sur '+' pour ajouter. L'AI traitera le texte reconnu."

#. settings-schema.json
msgid "Enabled: toggle prompt. Menu Name: how it appears in right-click menu. System Prompt: instructions for the AI (e.g., 'Translate to French' or 'Fix grammar')."
msgstr "Activé : activer/désactiver le prompt. Nom du menu : apparence dans le menu contextuel. Prompt système : instructions pour l'AI (ex. « Traduire en français » ou « Corriger la grammaire »)."

#. settings-schema.json - custom-prompts column title
msgid "Enabled"
msgstr "Activé"

#. settings-schema.json - custom-prompts column title
msgid "Menu Name (e.g., 'My Prompt')"
msgstr "Nom du menu (ex. « Mon prompt »)"

#. settings-schema.json - custom-prompts column title
msgid "System Prompt (AI instructions)"
msgstr "Prompt système (instructions pour l'AI)"

#. settings-schema.json - export/import header
msgid "Export / Import Settings"
msgstr "Exporter / Importer les paramètres"

#. settings-schema.json - export button
msgid "Export Settings to File..."
msgstr "Exporter les paramètres dans un fichier..."

#. settings-schema.json - export button tooltip
msgid "Save all settings to a JSON file"
msgstr "Enregistrer tous les paramètres dans un fichier JSON"

#. settings-schema.json - export button tooltip
msgid "Copy all settings to clipboard as JSON"
msgstr "Copier tous les paramètres dans le presse-papiers en JSON"

#. settings-schema.json - import button
msgid "Import Settings from File..."
msgstr "Importer les paramètres depuis un fichier..."

#. settings-schema.json - import button tooltip
msgid "Load settings from a JSON file"
msgstr "Charger les paramètres depuis un fichier JSON"

#. settings-schema.json - import button tooltip
msgid "Paste settings from clipboard JSON"
msgstr "Coller les paramètres depuis le JSON du presse-papiers"

#. applet.js - export/import menu
msgid "Export Settings to Clipboard"
msgstr "Exporter les paramètres dans le presse-papiers"

#. applet.js - export/import menu
msgid "Import Settings from Clipboard"
msgstr "Importer les paramètres du presse-papiers"

#. applet.js - import dialog title
msgid "Import Settings"
msgstr "Importer les paramètres"

#. applet.js - import dialog info
msgid "Version: %s"
msgstr "Version : %s"

#. applet.js - import dialog info
msgid "Date: %s"
msgstr "Date : %s"

#. applet.js - import dialog info
msgid "Settings count: %d"
msgstr "Nombre de paramètres : %d"

#. applet.js - import dialog warning
msgid "All current settings will be overwritten. Continue?"
msgstr "Tous les paramètres actuels seront écrasés. Continuer ?"

#. applet.js - import dialog button
msgid "Cancel"
msgstr "Annuler"

#. applet.js - import dialog button
msgid "Import"
msgstr "Importer"

#. applet.js - export notification
msgid "Warning: exported data contains your API key. Keep it secure!"
msgstr "Attention : les données exportées contiennent votre clé API. Conservez-la en sécurité !"

#. applet.js - export notification
msgid "Failed to export settings"
msgstr "Échec de l'exportation des paramètres"

#. applet.js - export notification
msgid "Settings exported to clipboard"
msgstr "Paramètres exportés dans le presse-papiers"

#. applet.js - export notification
msgid "Failed to copy to clipboard"
msgstr "Échec de la copie dans le presse-papiers"

#. applet.js - zenity dialog title
msgid "Export Settings to File"
msgstr "Exporter les paramètres dans un fichier"

#. applet.js - export notification
msgid "Settings exported to file"
msgstr "Paramètres exportés dans un fichier"

#. applet.js - export notification
msgid "Failed to save file: "
msgstr "Impossible d'enregistrer le fichier : "

#. applet.js - import notification
msgid "Clipboard is empty or cannot be read"
msgstr "Le presse-papiers est vide ou ne peut pas être lu"

#. applet.js - import notification
msgid "Invalid settings format in clipboard"
msgstr "Format de paramètres invalide dans le presse-papiers"

#. applet.js - import notification
msgid "Settings imported successfully (%d applied)"
msgstr "Paramètres importés avec succès (%d appliqués)"

#. applet.js - zenity dialog title
msgid "Import Settings from File"
msgstr "Importer les paramètres depuis un fichier"

#. applet.js - import notification
msgid "Failed to read file"
msgstr "Impossible de lire le fichier"

#. applet.js - import notification
msgid "Invalid settings file format"
msgstr "Format de fichier de paramètres invalide"

#. applet.js - compatible server connection dialog
msgid "Enter the server URL first"
msgstr "Saisissez d'abord l'URL du serveur"

#. applet.js - compatible server connection dialog
msgid "Server Connection"
msgstr "Connexion au serveur"

#. applet.js - compatible server connection dialog
msgid "Connecting to %s..."
msgstr "Connexion à %s..."

#. applet.js - compatible server connection dialog
msgid "Connection failed"
msgstr "Échec de la connexion"

#. applet.js - compatible server connection dialog
msgid "Unexpected response from %s. Make sure the package is fully updated."
msgstr "Réponse inattendue de %s. Vérifiez que le paquet est entièrement mis à jour."

#. applet.js - compatible server connection dialog
msgid "Connected, but the server returned no models. Enter the model name manually."
msgstr "Connecté, mais le serveur n'a renvoyé aucun modèle. Saisissez le nom du modèle manuellement."

#. applet.js - compatible server connection dialog
msgid "Connected. Models available: %d"
msgstr "Connecté. Modèles disponibles : %d"

#. applet.js - compatible server connection dialog
msgid "Click a model to use it for transcription."
msgstr "Cliquez sur un modèle pour l'utiliser pour la transcription."

#. applet.js - compatible server connection dialog
msgid "Transcription model set: %s"
msgstr "Modèle de transcription : %s"

#. applet.js - compatible server connection dialog
msgid "Speech recognition models"
msgstr "Modèles de reconnaissance vocale"

#. applet.js - compatible server connection dialog
msgid "Other models"
msgstr "Autres modèles"

#. applet.js - compatible server connection dialog
msgid "Click a model to use it for AI prompts."
msgstr "Cliquez sur un modèle pour l'utiliser pour les prompts IA."

#. applet.js - compatible server connection dialog
msgid "Chat model for prompts set: %s"
msgstr "Modèle de chat pour les prompts : %s"

#. applet.js - compatible server connection dialog
msgid "Chat models"
msgstr "Modèles de chat"

#. applet.js - notification
msgid "Choose a chat model for prompts in the settings"
msgstr "Choisissez un modèle de chat pour les prompts dans les paramètres"

#. applet.js - compatible server connection dialog
msgid "None of these models looks like a chat model. The API key may not have access to chat models on this server."
msgstr "Aucun de ces modèles ne ressemble à un modèle de chat. La clé API n'a peut-être pas accès aux modèles de chat sur ce serveur."

#. applet.js - compatible server connection dialog
msgid "None of these models looks like a speech recognition model. The API key may not have access to it on this server."
msgstr "Aucun de ces modèles ne ressemble à un modèle de reconnaissance vocale. La clé API n'y a peut-être pas accès sur ce serveur."

#. applet.js - compatible server connection dialog
msgid "Showing the first %d models; type any other name in the settings."
msgstr "Les %d premiers modèles sont affichés ; saisissez tout autre nom dans les paramètres."

#. applet.js - notification
msgid "No speech recognized"
msgstr "Aucune parole reconnue"
