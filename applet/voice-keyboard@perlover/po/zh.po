#. applet.js - tooltip
msgid "Voice Keyboard - Left-click to start/stop recording, Right-click for settings"
msgstr "语音输入 - 左键开始/停止录音，右键打开设置"

#. applet.js - menu
msgid "Settings"
msgstr "设置"

#. applet.js - error dialog
msgid "Voice Input Error"
msgstr "语音输入错误"

#. applet.js - error dialog
msgid "An unknown error occurred"
msgstr "发生未知错误"

#. applet.js - error dialog
msgid "Close"
msgstr "关闭"

#. applet.js - notification
msgid "Settings are not configured"
msgstr "设置未配置"

#. applet.js - notification
msgid "Maximum recording time reached"
msgstr "已达到最大录音时长"

#. applet.js - error
msgid "Transcription failed"
msgstr "转录失败"

#. applet.js - error
msgid "Recording failed"
msgstr "录音失败"

#. applet.js - notification
msgid "Configuration error - please check settings"
msgstr "配置错误 - 请检查设置"

#. applet.js - error
msgid "Process exited with code %d"
msgstr "进程以代码 %d 退出"

#. applet.js - notification
msgid "Voice input failed"
msgstr "语音输入失败"

#. applet.js - error
msgid "Failed to start voice input: "
msgstr "无法启动语音输入："

#. applet.js - notification
msgid "Server did not respond in time"
msgstr "服务器未及时响应"

#. applet.js - notification (custom prompts)
msgid "AI chat processing failed"
msgstr "AI聊天处理失败"

#. applet.js - retry dialog title
msgid "Speech was not recognized"
msgstr "语音未被识别"

#. applet.js - retry dialog body (transcription retry)
msgid "You can re-send the recorded audio without dictating again."
msgstr "您可以重新发送已录制的音频，无需再次口述。"

#. applet.js - retry dialog body (chat retry)
msgid "You can re-send the recognized text to the AI without dictating again."
msgstr "您可以将已识别的文本重新发送给 AI，无需再次口述。"

#. applet.js - retry dialog button
msgid "Retry"
msgstr "重试"

#. applet.js - paste-failed notification
msgid "Text is in the clipboard — paste it manually (Ctrl+V or Shift+Insert)"
msgstr "文本已在剪贴板中 — 请手动粘贴（Ctrl+V 或 Shift+Insert）"

#. settings-schema.json
msgid "Whisper mode"
msgstr "Whisper 模式"

#. settings-schema.json
msgid "OpenAI API"
msgstr "OpenAI API"

#. settings-schema.json
msgid "Local Server"
msgstr "本地服务器"

#. settings-schema.json
msgid "Choose OpenAI API, any server with an OpenAI-compatible API (e.g., your own inference hub) or a local Whisper server"
msgstr "选择 OpenAI API、任何具有 OpenAI 兼容 API 的服务器（例如您自己的推理中心）或本地 Whisper 服务器"

#. settings-schema.json
msgid "OpenAI API Key"
msgstr "OpenAI API 密钥"

#. settings-schema.json
msgid "Your OpenAI API key for Whisper (required if using OpenAI mode)"
msgstr "您的 OpenAI API 密钥（使用 OpenAI 模式时必需）"

#. settings-schema.json
msgid "OpenAI Model"
msgstr "OpenAI 模型"

#. settings-schema.json
msgid "Whisper-1 (standard, $0.006/min)"
msgstr "Whisper-1（标准，$0.006/分钟）"

#. settings-schema.json
msgid "GPT-4o Transcribe (best quality, $0.006/min)"
msgstr "GPT-4o Transcribe（最佳质量，$0.006/分钟）"

#. settings-schema.json
msgid "Whisper-1: Standard speech-to-text. GPT-4o Transcribe: Latest model with best accuracy for all languages"
msgstr "Whisper-1：标准语音转文字。GPT-4o Transcribe：最新模型，所有语言精度最高"

#. settings-schema.json
msgid "Local Whisper Server URL"
msgstr "本地 Whisper 服务器 URL"

#. settings-schema.json
msgid "URL of your local Whisper server (e.g., faster-whisper-server)"
msgstr "您的本地 Whisper 服务器 URL（例如 faster-whisper-server）"

#. settings-schema.json
msgid "OpenAI-compatible Server"
msgstr "OpenAI 兼容服务器"

#. settings-schema.json
msgid "Server Base URL"
msgstr "服务器基础 URL"

#. settings-schema.json
msgid "Base URL of the OpenAI-compatible API, usually ending with /v1 (e.g., https://hub.example.com/v1)"
msgstr "OpenAI 兼容 API 的基础 URL，通常以 /v1 结尾（例如 https://hub.example.com/v1）"

#. settings-schema.json
msgid "Server API Key"
msgstr "服务器 API 密钥"

#. settings-schema.json
msgid "API key for the server. Leave empty if the server does not require authentication"
msgstr "服务器的 API 密钥。如果服务器不需要身份验证，请留空"

#. settings-schema.json
msgid "Transcription Model"
msgstr "转录模型"

#. settings-schema.json
msgid "Model name exactly as the server knows it. Use 'Check Connection' to pick it from the server's list"
msgstr "与服务器上完全一致的模型名称。使用“检查连接”从服务器列表中选择"

#. settings-schema.json
msgid "Check Connection and Choose Transcription Model..."
msgstr "检查连接并选择转录模型..."

#. settings-schema.json
msgid "Connect to the server, show the list of available models and pick one with a click"
msgstr "连接服务器，显示可用模型列表，单击即可选择"

#. settings-schema.json
msgid "Chat Model (for prompts)"
msgstr "聊天模型（用于提示词）"

#. settings-schema.json
msgid "Chat model on the server for processing recognized text with custom prompts"
msgstr "服务器上用于通过自定义提示词处理识别文本的聊天模型"

#. settings-schema.json
msgid "Choose Chat Model for Prompts..."
msgstr "选择用于提示词的聊天模型..."

#. settings-schema.json
msgid "Connect to the server, show the list of available models and pick the chat model for custom prompts with a click"
msgstr "连接服务器，显示可用模型列表，单击选择用于提示词的聊天模型"

#. settings-schema.json
msgid "Allow reasoning (thinking) of the chat model"
msgstr "允许聊天模型推理（thinking）"

#. settings-schema.json
msgid "Off (recommended): reasoning models (Qwen3 and similar) answer many times faster, the request carries chat_template_kwargs: {\"enable_thinking\": false}, supported by vLLM and SGLang. On: the model decides itself and the field is not sent; also turn it on if the server rejects prompt requests"
msgstr "关闭（推荐）：推理模型（Qwen3 等）的响应快很多倍，请求中包含 chat_template_kwargs: {\"enable_thinking\": false}，vLLM 和 SGLang 支持。开启：由模型自行决定，不发送该字段；如果服务器拒绝提示词请求，也请开启"

#. settings-schema.json
msgid "Recognition language"
msgstr "识别语言"

#. settings-schema.json
msgid "Auto-detect"
msgstr "自动检测"

#. settings-schema.json
msgid "Russian"
msgstr "俄语"

#. settings-schema.json
msgid "English"
msgstr "英语"

#. settings-schema.json
msgid "Spanish"
msgstr "西班牙语"

#. settings-schema.json
msgid "German"
msgstr "德语"

#. settings-schema.json
msgid "French"
msgstr "法语"

#. settings-schema.json
msgid "Chinese"
msgstr "中文"

#. settings-schema.json
msgid "Japanese"
msgstr "日语"

#. settings-schema.json
msgid "Language for speech recognition"
msgstr "语音识别语言"

#. settings-schema.json
msgid "Maximum Recording Duration"
msgstr "最大录音时长"

#. settings-schema.json
msgid "Safety limit for maximum recording duration. Recording will automatically stop and transcribe when this limit is reached. Default: 5 minutes (300 seconds)."
msgstr "最大录音时长安全限制。达到此限制时，录音将自动停止并转录。默认：5分钟（300秒）。"

#. settings-schema.json
msgid "Path to whisper-voice-input script"
msgstr "whisper-voice-input 脚本路径"

#. settings-schema.json
msgid "Full path to the voice input script"
msgstr "语音输入脚本的完整路径"

#. settings-schema.json
msgid "Chat AI Model"
msgstr "Chat AI 模型"

#. settings-schema.json
msgid "GPT-4o Mini (fast, economical)"
msgstr "GPT-4o Mini（快速、经济）"

#. settings-schema.json
msgid "GPT-4o (best quality)"
msgstr "GPT-4o（最佳质量）"

#. settings-schema.json
msgid "GPT-5 (latest)"
msgstr "GPT-5（最新）"

#. settings-schema.json
msgid "Model for processing text with custom prompts"
msgstr "用于自定义提示词处理文本的模型"

#. settings-schema.json - custom-prompts-help label
msgid "Instructions: Click '+' to add. Use AI to process text. Example: Name='Fix Grammar', Prompt='Correct all typos in the following text:'"
msgstr "说明：点击「+」添加。使用AI处理文本。示例：名称=「修正语法」，提示词=「修正以下文本中的所有错误：」"

#. settings-schema.json
msgid "Custom Prompts: click '+' to add. Use AI to process recognized text."
msgstr "提示词：点击「+」添加。使用AI处理识别的文本。"

#. settings-schema.json
msgid "Enabled: toggle prompt. Menu Name: how it appears in right-click menu. System Prompt: instructions for the AI (e.g., 'Translate to French' or 'Fix grammar')."
msgstr "启用：开关提示词。菜单名称：在右键菜单中的显示名。系统提示词：AI的指令（如「翻译成法语」或「修正语法」）。"

#. settings-schema.json - custom-prompts column title
msgid "Enabled"
msgstr "启用"

#. settings-schema.json - custom-prompts column title
msgid "Menu Name (e.g., 'My Prompt')"
msgstr "菜单名称（如「我的提示词」）"

#. settings-schema.json - custom-prompts column title
msgid "System Prompt (AI instructions)"
msgstr "系统提示词（AI指令）"

#. settings-schema.json - export/import header
msgid "Export / Import Settings"
msgstr "导出 / 导入设置"

#. settings-schema.json - export button
msgid "Export Settings to File..."
msgstr "导出设置到文件..."

#. settings-schema.json - export button tooltip
msgid "Save all settings to a JSON file"
msgstr "将所有设置保存到 JSON 文件"

#. settings-schema.json - export button tooltip
msgid "Copy all settings to clipboard as JSON"
msgstr "将所有设置以 JSON 格式复制到剪贴板"

#. settings-schema.json - import button
msgid "Import Settings from File..."
msgstr "从文件导入设置..."

#. settings-schema.json - import button tooltip
msgid "Load settings from a JSON file"
msgstr "从 JSON 文件加载设置"

#. settings-schema.json - import button tooltip
msgid "Paste settings from clipboard JSON"
msgstr "从剪贴板的 JSON 粘贴设置"

#. applet.js - export/import menu
msgid "Export Settings to Clipboard"
msgstr "导出设置到剪贴板"

#. applet.js - export/import menu
msgid "Import Settings from Clipboard"
msgstr "从剪贴板导入设置"

#. applet.js - import dialog title
msgid "Import Settings"
msgstr "导入设置"

#. applet.js - import dialog info
msgid "Version: %s"
msgstr "版本：%s"

#. applet.js - import dialog info
msgid "Date: %s"
msgstr "日期：%s"

#. applet.js - import dialog info
msgid "Settings count: %d"
msgstr "设置数量：%d"

#. applet.js - import dialog warning
msgid "All current settings will be overwritten. Continue?"
msgstr "所有当前设置将被覆盖。是否继续？"

#. applet.js - import dialog button
msgid "Cancel"
msgstr "取消"

#. applet.js - import dialog button
msgid "Import"
msgstr "导入"

#. applet.js - export notification
msgid "Warning: exported data contains your API key. Keep it secure!"
msgstr "警告：导出的数据包含您的API密钥。请妥善保管！"

#. applet.js - export notification
msgid "Failed to export settings"
msgstr "导出设置失败"

#. applet.js - export notification
msgid "Settings exported to clipboard"
msgstr "设置已导出到剪贴板"

#. applet.js - export notification
msgid "Failed to copy to clipboard"
msgstr "复制到剪贴板失败"

#. applet.js - zenity dialog title
msgid "Export Settings to File"
msgstr "导出设置到文件"

#. applet.js - export notification
msgid "Settings exported to file"
msgstr "设置已导出到文件"

#. applet.js - export notification
msgid "Failed to save file: "
msgstr "保存文件失败："

#. applet.js - import notification
msgid "Clipboard is empty or cannot be read"
msgstr "剪贴板为空或无法读取"

#. applet.js - import notification
msgid "Invalid settings format in clipboard"
msgstr "剪贴板中的设置格式无效"

#. applet.js - import notification
msgid "Settings imported successfully (%d applied)"
msgstr "设置导入成功（已应用 %d 项）"

#. applet.js - zenity dialog title
msgid "Import Settings from File"
msgstr "从文件导入设置"

#. applet.js - import notification
msgid "Failed to read file"
msgstr "读取文件失败"

#. applet.js - import notification
msgid "Invalid settings file format"
msgstr "设置文件格式无效"

#. applet.js - compatible server connection dialog
msgid "Enter the server URL first"
msgstr "请先输入服务器 URL"

#. applet.js - compatible server connection dialog
msgid "Server Connection"
msgstr "服务器连接"

#. applet.js - compatible server connection dialog
msgid "Connecting to %s..."
msgstr "正在连接 %s..."

#. applet.js - compatible server connection dialog
msgid "Connection failed"
msgstr "连接失败"

#. applet.js - compatible server connection dialog
msgid "Unexpected response from %s. Make sure the package is fully updated."
msgstr "%s 返回了意外的响应。请确认软件包已完整更新。"

#. applet.js - compatible server connection dialog
msgid "Connected, but the server returned no models. Enter the model name manually."
msgstr "已连接，但服务器未返回任何模型。请手动输入模型名称。"

#. applet.js - compatible server connection dialog
msgid "Connected. Models available: %d"
msgstr "已连接。可用模型：%d"

#. applet.js - compatible server connection dialog
msgid "Click a model to use it for transcription."
msgstr "单击模型即可将其用于转录。"

#. applet.js - compatible server connection dialog
msgid "Transcription model set: %s"
msgstr "已设置转录模型：%s"

#. applet.js - compatible server connection dialog
msgid "Speech recognition models"
msgstr "语音识别模型"

#. applet.js - compatible server connection dialog
msgid "Other models"
msgstr "其他模型"

#. applet.js - compatible server connection dialog
msgid "Click a model to use it for AI prompts."
msgstr "单击模型即可将其用于 AI 提示词。"

#. applet.js - compatible server connection dialog
msgid "Chat model for prompts set: %s"
msgstr "已设置提示词聊天模型：%s"

#. applet.js - compatible server connection dialog
msgid "Chat models"
msgstr "聊天模型"

#. applet.js - notification
msgid "Choose a chat model for prompts in the settings"
msgstr "请在设置中选择用于提示词的聊天模型"

#. applet.js - compatible server connection dialog
msgid "None of these models looks like a chat model. The API key may not have access to chat models on this server."
msgstr "这些模型看起来都不是聊天模型。该 API 密钥可能无权访问此服务器上的聊天模型。"

#. applet.js - compatible server connection dialog
msgid "None of these models looks like a speech recognition model. The API key may not have access to it on this server."
msgstr "这些模型看起来都不是语音识别模型。该 API 密钥可能无权访问此服务器上的此类模型。"

#. applet.js - compatible server connection dialog
msgid "Showing the first %d models; type any other name in the settings."
msgstr "仅显示前 %d 个模型；其他名称可在设置中手动输入。"
