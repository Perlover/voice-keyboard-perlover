#. applet.js - tooltip
msgid "Voice Keyboard - Left-click to start/stop recording, Right-click for settings"
msgstr "Spracheingabe - Linksklick zum Starten/Stoppen der Aufnahme, Rechtsklick für Einstellungen"

#. applet.js - menu
msgid "Settings"
msgstr "Einstellungen"

#. applet.js - error dialog
msgid "Voice Input Error"
msgstr "Fehler bei der Spracheingabe"

#. applet.js - error dialog
msgid "An unknown error occurred"
msgstr "Ein unbekannter Fehler ist aufgetreten"

#. applet.js - error dialog
msgid "Close"
msgstr "Schließen"

#. applet.js - notification
msgid "Settings are not configured"
msgstr "Einstellungen sind nicht konfiguriert"

#. applet.js - notification
msgid "Maximum recording time reached"
msgstr "Maximale Aufnahmezeit erreicht"

#. applet.js - error
msgid "Transcription failed"
msgstr "Transkription fehlgeschlagen"

#. applet.js - error
msgid "Recording failed"
msgstr "Aufnahme fehlgeschlagen"

#. applet.js - notification
msgid "Configuration error - please check settings"
msgstr "Konfigurationsfehler — bitte Einstellungen prüfen"

#. applet.js - error
msgid "Process exited with code %d"
msgstr "Prozess mit Code %d beendet"

#. applet.js - notification
msgid "Voice input failed"
msgstr "Spracheingabe fehlgeschlagen"

#. applet.js - error
msgid "Failed to start voice input: "
msgstr "Spracheingabe konnte nicht gestartet werden: "

#. applet.js - notification
msgid "Server did not respond in time"
msgstr "Server hat nicht rechtzeitig geantwortet"

#. applet.js - notification (custom prompts)
msgid "AI chat processing failed"
msgstr "AI-Chat-Verarbeitung fehlgeschlagen"

#. applet.js - retry dialog title
msgid "Speech was not recognized"
msgstr "Sprache wurde nicht erkannt"

#. applet.js - retry dialog body (transcription retry)
msgid "You can re-send the recorded audio without dictating again."
msgstr "Sie können die Aufnahme erneut senden, ohne noch einmal zu diktieren."

#. applet.js - retry dialog body (chat retry)
msgid "You can re-send the recognized text to the AI without dictating again."
msgstr "Sie können den erkannten Text erneut an die KI senden, ohne noch einmal zu diktieren."

#. applet.js - retry dialog button
msgid "Retry"
msgstr "Wiederholen"

#. applet.js - paste-failed notification
msgid "Text is in the clipboard — paste it manually (Ctrl+V or Shift+Insert)"
msgstr "Der Text ist in der Zwischenablage — bitte manuell einfügen (Strg+V oder Umschalt+Einfg)"

#. settings-schema.json
msgid "Whisper mode"
msgstr "Whisper-Modus"

#. settings-schema.json
msgid "OpenAI API"
msgstr "OpenAI API"

#. settings-schema.json
msgid "Local Server"
msgstr "Lokaler Server"

#. settings-schema.json
msgid "Choose OpenAI API, any server with an OpenAI-compatible API (e.g., your own inference hub) or a local Whisper server"
msgstr "Wählen Sie die OpenAI API, einen beliebigen Server mit OpenAI-kompatibler API (z. B. Ihren eigenen Inference Hub) oder einen lokalen Whisper-Server"

#. settings-schema.json
msgid "OpenAI API Key"
msgstr "OpenAI API-Schlüssel"

#. settings-schema.json
msgid "Your OpenAI API key for Whisper (required if using OpenAI mode)"
msgstr "Ihr OpenAI API-Schlüssel für Whisper (erforderlich im OpenAI-Modus)"

#. settings-schema.json
msgid "OpenAI Model"
msgstr "OpenAI-Modell"

#. settings-schema.json
msgid "Whisper-1 (standard, $0.006/min)"
msgstr "Whisper-1 (Standard, $0,006/Min)"

#. settings-schema.json
msgid "GPT-4o Transcribe (best quality, $0.006/min)"
msgstr "GPT-4o Transcribe (beste Qualität, $0,006/Min)"

#. settings-schema.json
msgid "Whisper-1: Standard speech-to-text. GPT-4o Transcribe: Latest model with best accuracy for all languages"
msgstr "Whisper-1: Standard-Spracherkennung. GPT-4o Transcribe: Neuestes Modell mit bester Genauigkeit für alle Sprachen"

#. settings-schema.json
msgid "Local Whisper Server URL"
msgstr "URL des lokalen Whisper-Servers"

#. settings-schema.json
msgid "URL of your local Whisper server (e.g., faster-whisper-server)"
msgstr "URL Ihres lokalen Whisper-Servers (z.B. faster-whisper-server)"

#. settings-schema.json
msgid "OpenAI-compatible Server"
msgstr "OpenAI-kompatibler Server"

#. settings-schema.json
msgid "Server Base URL"
msgstr "Basis-URL des Servers"

#. settings-schema.json
msgid "Base URL of the OpenAI-compatible API, usually ending with /v1 (e.g., https://hub.example.com/v1)"
msgstr "Basis-URL der OpenAI-kompatiblen API, endet meist auf /v1 (z. B. https://hub.example.com/v1)"

#. settings-schema.json
msgid "Server API Key"
msgstr "API-Schlüssel des Servers"

#. settings-schema.json
msgid "API key for the server. Leave empty if the server does not require authentication"
msgstr "API-Schlüssel für den Server. Leer lassen, wenn der Server keine Authentifizierung erfordert"

#. settings-schema.json
msgid "Transcription Model"
msgstr "Transkriptionsmodell"

#. settings-schema.json
msgid "Model name exactly as the server knows it. Use 'Check Connection' to pick it from the server's list"
msgstr "Modellname genau so, wie ihn der Server kennt. Mit „Verbindung prüfen“ aus der Liste des Servers auswählen"

#. settings-schema.json
msgid "Check Connection and Choose Transcription Model..."
msgstr "Verbindung prüfen und Transkriptionsmodell wählen..."

#. settings-schema.json
msgid "Connect to the server, show the list of available models and pick one with a click"
msgstr "Mit dem Server verbinden, verfügbare Modelle anzeigen und eines per Klick auswählen"

#. settings-schema.json
msgid "Chat Model (for prompts)"
msgstr "Chat-Modell (für Prompts)"

#. settings-schema.json
msgid "Chat model on the server for processing recognized text with custom prompts"
msgstr "Chat-Modell auf dem Server zur Verarbeitung des erkannten Textes mit eigenen Prompts"

#. settings-schema.json
msgid "Choose Chat Model for Prompts..."
msgstr "Chat-Modell für Prompts wählen..."

#. settings-schema.json
msgid "Connect to the server, show the list of available models and pick the chat model for custom prompts with a click"
msgstr "Mit dem Server verbinden, verfügbare Modelle anzeigen und das Chat-Modell für Prompts per Klick auswählen"

#. settings-schema.json
msgid "Allow reasoning (thinking) of the chat model"
msgstr "Reasoning (Thinking) des Chat-Modells erlauben"

#. settings-schema.json
msgid "Off (recommended): reasoning models (Qwen3 and similar) answer many times faster, the request carries chat_template_kwargs: {\"enable_thinking\": false}, supported by vLLM and SGLang. On: the model decides itself and the field is not sent; also turn it on if the server rejects prompt requests"
msgstr "Aus (empfohlen): Reasoning-Modelle (Qwen3 u. ä.) antworten um ein Vielfaches schneller, die Anfrage enthält chat_template_kwargs: {\"enable_thinking\": false}, unterstützt von vLLM und SGLang. Ein: Das Modell entscheidet selbst, das Feld wird nicht gesendet; auch einschalten, wenn der Server Prompt-Anfragen ablehnt"

#. settings-schema.json
msgid "Recognition language"
msgstr "Erkennungssprache"

#. settings-schema.json
msgid "Auto-detect"
msgstr "Automatische Erkennung"

#. settings-schema.json
msgid "Russian"
msgstr "Russisch"

#. settings-schema.json
msgid "English"
msgstr "Englisch"

#. settings-schema.json
msgid "Spanish"
msgstr "Spanisch"

#. settings-schema.json
msgid "German"
msgstr "Deutsch"

#. settings-schema.json
msgid "French"
msgstr "Französisch"

#. settings-schema.json
msgid "Chinese"
msgstr "Chinesisch"

#. settings-schema.json
msgid "Japanese"
msgstr "Japanisch"

#. settings-schema.json
msgid "Language for speech recognition"
msgstr "Sprache für Spracherkennung"

#. settings-schema.json
msgid "Maximum Recording Duration"
msgstr "Maximale Aufnahmedauer"

#. settings-schema.json
msgid "Safety limit for maximum recording duration. Recording will automatically stop and transcribe when this limit is reached. Default: 5 minutes (300 seconds)."
msgstr "Sicherheitslimit für die maximale Aufnahmedauer. Die Aufnahme wird automatisch gestoppt und transkribiert, wenn dieses Limit erreicht wird. Standard: 5 Minuten (300 Sekunden)."

#. settings-schema.json
msgid "Path to whisper-voice-input script"
msgstr "Pfad zum whisper-voice-input-Skript"

#. settings-schema.json
msgid "Full path to the voice input script"
msgstr "Vollständiger Pfad zum Spracheingabe-Skript"

#. settings-schema.json
msgid "Chat AI Model"
msgstr "Chat-AI-Modell"

#. settings-schema.json
msgid "GPT-4o Mini (fast, economical)"
msgstr "GPT-4o Mini (schnell, wirtschaftlich)"

#. settings-schema.json
msgid "GPT-4o (best quality)"
msgstr "GPT-4o (beste Qualität)"

#. settings-schema.json
msgid "GPT-5 (latest)"
msgstr "GPT-5 (neueste)"

#. settings-schema.json
msgid "Model for processing text with custom prompts"
msgstr "Modell zur Textverarbeitung mit benutzerdefinierten Prompts"

#. settings-schema.json - custom-prompts-help label
msgid "Instructions: Click '+' to add. Use AI to process text. Example: Name='Fix Grammar', Prompt='Correct all typos in the following text:'"
msgstr "Anleitung: Klicken Sie auf '+' zum Hinzufügen. AI verarbeitet den Text. Beispiel: Name='Grammatik korrigieren', Prompt='Korrigiere alle Tippfehler im folgenden Text:'"

#. settings-schema.json
msgid "Custom Prompts: click '+' to add. Use AI to process recognized text."
msgstr "Prompts: Klicken Sie auf '+' zum Hinzufügen. AI verarbeitet den erkannten Text."

#. settings-schema.json
msgid "Enabled: toggle prompt. Menu Name: how it appears in right-click menu. System Prompt: instructions for the AI (e.g., 'Translate to French' or 'Fix grammar')."
msgstr "Aktiviert: Prompt ein-/ausschalten. Menüname: Anzeige im Kontextmenü. System-Prompt: Anweisungen für die AI (z.B. 'Übersetze ins Französische' oder 'Grammatik korrigieren')."

#. settings-schema.json - custom-prompts column title
msgid "Enabled"
msgstr "Aktiviert"

#. settings-schema.json - custom-prompts column title
msgid "Menu Name (e.g., 'My Prompt')"
msgstr "Menüname (z.B. 'Mein Prompt')"

#. settings-schema.json - custom-prompts column title
msgid "System Prompt (AI instructions)"
msgstr "System-Prompt (AI-Anweisungen)"

#. settings-schema.json - export/import header
msgid "Export / Import Settings"
msgstr "Einstellungen exportieren / importieren"

#. settings-schema.json - export button
msgid "Export Settings to File..."
msgstr "Einstellungen in Datei exportieren..."

#. settings-schema.json - export button tooltip
msgid "Save all settings to a JSON file"
msgstr "Alle Einstellungen in eine JSON-Datei speichern"

#. settings-schema.json - export button tooltip
msgid "Copy all settings to clipboard as JSON"
msgstr "Alle Einstellungen als JSON in die Zwischenablage kopieren"

#. settings-schema.json - import button
msgid "Import Settings from File..."
msgstr "Einstellungen aus Datei importieren..."

#. settings-schema.json - import button tooltip
msgid "Load settings from a JSON file"
msgstr "Einstellungen aus einer JSON-Datei laden"

#. settings-schema.json - import button tooltip
msgid "Paste settings from clipboard JSON"
msgstr "Einstellungen aus JSON in der Zwischenablage einfügen"

#. applet.js - export/import menu
msgid "Export Settings to Clipboard"
msgstr "Einstellungen in Zwischenablage exportieren"

#. applet.js - export/import menu
msgid "Import Settings from Clipboard"
msgstr "Einstellungen aus Zwischenablage importieren"

#. applet.js - import dialog title
msgid "Import Settings"
msgstr "Einstellungen importieren"

#. applet.js - import dialog info
msgid "Version: %s"
msgstr "Version: %s"

#. applet.js - import dialog info
msgid "Date: %s"
msgstr "Datum: %s"

#. applet.js - import dialog info
msgid "Settings count: %d"
msgstr "Anzahl der Einstellungen: %d"

#. applet.js - import dialog warning
msgid "All current settings will be overwritten. Continue?"
msgstr "Alle aktuellen Einstellungen werden überschrieben. Fortfahren?"

#. applet.js - import dialog button
msgid "Cancel"
msgstr "Abbrechen"

#. applet.js - import dialog button
msgid "Import"
msgstr "Importieren"

#. applet.js - export notification
msgid "Warning: exported data contains your API key. Keep it secure!"
msgstr "Warnung: Die exportierten Daten enthalten Ihren API-Schlüssel. Bewahren Sie ihn sicher auf!"

#. applet.js - export notification
msgid "Failed to export settings"
msgstr "Export der Einstellungen fehlgeschlagen"

#. applet.js - export notification
msgid "Settings exported to clipboard"
msgstr "Einstellungen in Zwischenablage exportiert"

#. applet.js - export notification
msgid "Failed to copy to clipboard"
msgstr "Kopieren in Zwischenablage fehlgeschlagen"

#. applet.js - zenity dialog title
msgid "Export Settings to File"
msgstr "Einstellungen in Datei exportieren"

#. applet.js - export notification
msgid "Settings exported to file"
msgstr "Einstellungen in Datei exportiert"

#. applet.js - export notification
msgid "Failed to save file: "
msgstr "Datei konnte nicht gespeichert werden: "

#. applet.js - import notification
msgid "Clipboard is empty or cannot be read"
msgstr "Zwischenablage ist leer oder kann nicht gelesen werden"

#. applet.js - import notification
msgid "Invalid settings format in clipboard"
msgstr "Ungültiges Einstellungsformat in der Zwischenablage"

#. applet.js - import notification
msgid "Settings imported successfully (%d applied)"
msgstr "Einstellungen erfolgreich importiert (%d angewendet)"

#. applet.js - zenity dialog title
msgid "Import Settings from File"
msgstr "Einstellungen aus Datei importieren"

#. applet.js - import notification
msgid "Failed to read file"
msgstr "Datei konnte nicht gelesen werden"

#. applet.js - import notification
msgid "Invalid settings file format"
msgstr "Ungültiges Einstellungsdateiformat"

#. applet.js - compatible server connection dialog
msgid "Enter the server URL first"
msgstr "Bitte zuerst die Server-URL eingeben"

#. applet.js - compatible server connection dialog
msgid "Server Connection"
msgstr "Serververbindung"

#. applet.js - compatible server connection dialog
msgid "Connecting to %s..."
msgstr "Verbinde mit %s..."

#. applet.js - compatible server connection dialog
msgid "Connection failed"
msgstr "Verbindung fehlgeschlagen"

#. applet.js - compatible server connection dialog
msgid "Unexpected response from %s. Make sure the package is fully updated."
msgstr "Unerwartete Antwort von %s. Stellen Sie sicher, dass das Paket vollständig aktualisiert ist."

#. applet.js - compatible server connection dialog
msgid "Connected, but the server returned no models. Enter the model name manually."
msgstr "Verbunden, aber der Server hat keine Modelle geliefert. Geben Sie den Modellnamen manuell ein."

#. applet.js - compatible server connection dialog
msgid "Connected. Models available: %d"
msgstr "Verbunden. Verfügbare Modelle: %d"

#. applet.js - compatible server connection dialog
msgid "Click a model to use it for transcription."
msgstr "Klicken Sie auf ein Modell, um es für die Transkription zu verwenden."

#. applet.js - compatible server connection dialog
msgid "Transcription model set: %s"
msgstr "Transkriptionsmodell: %s"

#. applet.js - compatible server connection dialog
msgid "Speech recognition models"
msgstr "Spracherkennungsmodelle"

#. applet.js - compatible server connection dialog
msgid "Other models"
msgstr "Andere Modelle"

#. applet.js - compatible server connection dialog
msgid "Click a model to use it for AI prompts."
msgstr "Klicken Sie auf ein Modell, um es für KI-Prompts zu verwenden."

#. applet.js - compatible server connection dialog
msgid "Chat model for prompts set: %s"
msgstr "Chat-Modell für Prompts: %s"

#. applet.js - compatible server connection dialog
msgid "Chat models"
msgstr "Chat-Modelle"

#. applet.js - notification
msgid "Choose a chat model for prompts in the settings"
msgstr "Wählen Sie in den Einstellungen ein Chat-Modell für Prompts"

#. applet.js - compatible server connection dialog
msgid "None of these models looks like a chat model. The API key may not have access to chat models on this server."
msgstr "Keines dieser Modelle sieht wie ein Chat-Modell aus. Möglicherweise hat der API-Schlüssel auf diesem Server keinen Zugriff auf Chat-Modelle."

#. applet.js - compatible server connection dialog
msgid "None of these models looks like a speech recognition model. The API key may not have access to it on this server."
msgstr "Keines dieser Modelle sieht wie ein Spracherkennungsmodell aus. Möglicherweise hat der API-Schlüssel auf diesem Server keinen Zugriff darauf."

#. applet.js - compatible server connection dialog
msgid "Showing the first %d models; type any other name in the settings."
msgstr "Es werden die ersten %d Modelle angezeigt; jeden anderen Namen können Sie in den Einstellungen eingeben."

#. applet.js - notification
msgid "No speech recognized"
msgstr "Keine Sprache erkannt"
